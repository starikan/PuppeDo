{
  "compilerOptions": {
    // "strict": true,
    "target": "ESNext",
    "types": ["node", "webpack-env", "vitest/globals"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "sourceMap": true,
    "esModuleInterop": true,
    "removeComments": true,
    "declaration": true,
    "declarationDir": "dist"
  },
  "lib": ["es2020", "es2020.array"],
  "include": ["src/**/*", "src.tests/**/*", "index.ts"],
  "exclude": ["node_modules"]
}
